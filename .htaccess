# cPanel Node.js (Passenger) manages routing for the Node app.
# Do not force proxy to a fixed port here, as it can break Passenger.
# If you serve the frontend as static files only, uncomment the SPA fallback below.
#
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteBase /
#   RewriteRule ^index\.html$ - [L]
#   RewriteCond %{REQUEST_FILENAME} !-f
#   RewriteCond %{REQUEST_FILENAME} !-d
#   RewriteRule . /index.html [L]
# </IfModule>
